{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "collections/*": ["./.source/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "components/bento-one",
    "components/bento-two",
    "components/testimonials",
    "components/resources",
    "components/products",
    "components/pricing",
    "components/feedbacks",
    "components/faq",
    "components/comparison",
    "components/blogs",
    "components/acebuilder",
    "components/logo-cloud.tsx",
    "components/header.tsx",
    "components/kibo-ui",
    "components/sliding-number.tsx",
    "components/square-dots.tsx"
  ]
}
